{
  "name": "@browser-use-extension/engine",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Browser control engine for Chrome extensions: a persistent code runtime, tab ownership, input, observation, hand-off and network learning.",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./boosts-build": "./boosts-build.mjs"
  },
  "dependencies": {
    "acorn": "8.18.0",
    "zod": "4.6.5",
    "@browser-use-extension/protocol": "workspace:*",
    "site-boosts": "link:../../../site-boosts"
  },
  "devDependencies": {
    "@types/chrome": "0.3.0"
  },
  "files": [
    "src",
    "assets",
    "boosts-build.mjs"
  ]
}

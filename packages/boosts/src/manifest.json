{
  "manifest_version": 3,
  "name": "Site Boosts",
  "version": "0.1.0",
  "description": "Make any site behave your way: describe a change or point at it, and it stays. Styles, zaps, actions, network rules and userscripts.",
  "key": "",
  "minimum_chrome_version": "135",
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Site Boosts", "default_popup": "popup.html" },
  "options_page": "manager.html",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "scripting",
    "userScripts",
    "declarativeNetRequest",
    "webNavigation",
    "contextMenus",
    "notifications",
    "downloads",
    "cookies",
    "alarms",
    "offscreen",
    "clipboardWrite"
  ],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "commands": {
    "zap": {
      "suggested_key": { "default": "Alt+Shift+Z" },
      "description": "Hide something on this page"
    },
    "chip": {
      "suggested_key": { "default": "Alt+Shift+B" },
      "description": "Open Site Boosts on this page"
    }
  },
  "icons": { "16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png" }
}

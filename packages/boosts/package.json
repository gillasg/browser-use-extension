{
  "name": "site-boosts",
  "version": "0.1.0",
  "private": true,
  "description": "Make any site behave your way: describe a change in plain English, or point at it, and it stays. Styles, zaps, actions, network rules and userscripts in one Chrome extension.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    "./embed": {
      "types": "./src/embed/api.d.ts",
      "default": "./src/embed/index.ts"
    },
    "./embed-build": "./scripts/embed-build.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,html,css}\" \"test/**/*.mjs\" \"scripts/**/*.mjs\" \"*.{json,yaml,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\" \"test/**/*.mjs\" \"scripts/**/*.mjs\" \"*.{json,yaml,mjs}\"",
    "test": "node --test --test-timeout=180000 test/*.test.mjs",
    "test:unit": "pnpm build && node --test --test-timeout=180000 test/unit.test.mjs",
    "test:e2e": "pnpm build && node --test --test-timeout=180000 test/e2e.test.mjs",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm build && pnpm test",
    "pack": "node scripts/pack.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/chrome": "0.3.0",
    "@types/node": "26.6.3",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "linkedom": "0.18.13",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "ws": "8.22.0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.14",
    "acorn": "8.19.0",
    "codemirror": "6.0.2",
    "fflate": "0.8.3",
    "less": "4.9.1"
  }
}
